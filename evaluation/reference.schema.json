{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get-myhome.local/schemas/core-reference-v0.1.json",
  "title": "Get-MyHome document-level core reference",
  "type": "object",
  "required": ["schema_version", "complex_id", "source", "review", "labels"],
  "properties": {
    "schema_version": {"const": "core_reference_v0.1"},
    "complex_id": {"type": "string", "pattern": "^\\d{10}$"},
    "source": {
      "type": "object",
      "required": ["pdf_filename", "text_filename", "pdf_sha256", "page_count"],
      "properties": {
        "pdf_filename": {"type": "string", "minLength": 1},
        "text_filename": {"type": "string", "minLength": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["text_source_review", "pdf_visual_review", "scope", "excluded_fields"],
      "properties": {
        "text_source_review": {"const": "COMPLETE"},
        "pdf_visual_review": {"const": "COMPLETE"},
        "scope": {"const": "DOCUMENT_LEVEL_CORE"},
        "excluded_fields": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "required": ["payment_schedule", "interim_loan"],
      "properties": {
        "payment_schedule": {
          "type": "object",
          "required": [
            "down_payment_ratio",
            "interim_payment_ratio",
            "balance_payment_ratio",
            "interim_installments",
            "balance_due_text",
            "move_in_month"
          ],
          "properties": {
            "down_payment_ratio": {"$ref": "#/$defs/ratioLabel"},
            "interim_payment_ratio": {"$ref": "#/$defs/ratioLabel"},
            "balance_payment_ratio": {"$ref": "#/$defs/ratioLabel"},
            "interim_installments": {"$ref": "#/$defs/installmentsLabel"},
            "balance_due_text": {"$ref": "#/$defs/textLabel"},
            "move_in_month": {"$ref": "#/$defs/monthLabel"}
          },
          "additionalProperties": false
        },
        "interim_loan": {
          "type": "object",
          "required": [
            "arrangement_status",
            "arranged_ratio",
            "self_funding_ratio",
            "interest_type",
            "prepay_requirement_ratio"
          ],
          "properties": {
            "arrangement_status": {"$ref": "#/$defs/arrangementLabel"},
            "arranged_ratio": {"$ref": "#/$defs/nullableRatioLabel"},
            "self_funding_ratio": {"$ref": "#/$defs/nullableRatioLabel"},
            "interest_type": {"$ref": "#/$defs/interestLabel"},
            "prepay_requirement_ratio": {"$ref": "#/$defs/ratioLabel"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["page", "raw_text"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "raw_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verification": {
      "enum": [
        "VERIFIED_TEXT",
        "VERIFIED_NORMALIZED",
        "VERIFIED_DERIVED",
        "VERIFIED_NOT_STATED"
      ]
    },
    "ratioLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "nullableRatioLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "installment": {
      "type": "object",
      "required": ["number", "ratio", "due_date"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "due_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "installmentsLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/installment"}},
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "textLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "monthLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "arrangementLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {
          "enum": ["NOT_STATED", "NOT_AVAILABLE", "PLANNED", "UNDER_DISCUSSION", "BANK_SELECTED"]
        },
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "interestLabel": {
      "type": "object",
      "required": ["value", "verification", "evidence"],
      "properties": {
        "value": {
          "enum": [
            "INTEREST_FREE",
            "DEFERRED_INTEREST",
            "BORROWER_PAYS",
            "MIXED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "verification": {"$ref": "#/$defs/verification"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
