AI_PROVIDER=ollama
# 외부 노출 시 반드시 32자 이상의 무작위 값을 설정하고 Authorization: Bearer 헤더로 전달
AI_API_KEY=
ENABLE_DOCS=false
# 두 개는 로컬 개발 전용 우회 옵션입니다. 외부 연결에서는 false를 유지하세요.
ALLOW_UNAUTHENTICATED_DEV=false
ALLOW_UNRESTRICTED_PDF_HOSTS_DEV=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=4096
OLLAMA_CHUNK_MAX_CHARS=10000
OLLAMA_KEEP_ALIVE=10m
MAX_CONCURRENT_ANALYSES=1
ANALYSIS_QUEUE_TIMEOUT_SECONDS=1
ANALYSIS_TIMEOUT_SECONDS=300
READINESS_TIMEOUT_SECONDS=5

# Optional paid provider fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini-2025-08-07
OPENAI_TIMEOUT_SECONDS=90
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
PDF_MAX_BYTES=52428800
PDF_ALLOWED_HOSTS=
PDF_TEXT_TIMEOUT_SECONDS=30
MAX_PDF_PAGES=200
MAX_CANDIDATE_PAGES=24
MAX_CANDIDATE_CHARS=180000
